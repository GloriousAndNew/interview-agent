# Default: SSH tunnel access only, no public HTTP login.
APP_VERSION=0.2.0
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
PUBLIC_ORIGIN=http://127.0.0.1:18501
SERVER_ALLOW_HTTP=1
CADDYFILE=./Caddyfile.loopback
DOMAIN=localhost

# Generate a random value; do not reuse passwords or API keys.
GATEWAY_SECRET=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

SERVER_JOB_CONCURRENCY=2
SERVER_ANSWER_CONCURRENCY=2
SERVER_UPLOAD_MB=100
PIP_INDEX_URL=https://pypi.org/simple

AliApiKey=
deepseek=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
ASR_STORAGE_BUCKET=
OSS_ENDPOINT=
